{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "rootDir": "src",
    "outDir": "../../apps/dist",
    "tsBuildInfoFile": "../../apps/dist/tsconfig.lib.tsbuildinfo",
    "emitDeclarationOnly": false,
    "lib": [
      "es2017",
      "dom"
    ],
    "forceConsistentCasingInFileNames": true,
    "types": [
      "node"
    ],
    "importHelpers": false
  },
  "include": [
    "src/**/*.ts"
  ],
  "references": [],
  "exclude": [
    "jest.config.ts",
    "jest.config.cts",
    "src/**/*.spec.ts",
    "src/**/*.test.ts"
  ]
}